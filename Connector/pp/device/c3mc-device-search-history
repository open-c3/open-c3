# -*- coding: utf-8 -*-

import re
import sys
import subprocess

def run_command(cmd):
    result = subprocess.run(cmd, capture_output=True, text=True, shell=True)
    if result.returncode != 0:
        if result.stderr:
            print(result.stderr, file=sys.stderr, end='') 
            return None
        else:
            return []
    return result.stdout.splitlines()

def process_result(line):
    match = re.search(r'timemachine/(\d+-\d+)/cache', line)
    if match:
        return match.group(1)
    if '/curr/cache/' in line:
        return 'curr'
    return None

def main( search_text ):
    result = run_command(f"grep -F -l {search_text} /data/open-c3-data/device/timemachine/*/cache/c3mc-device-cat-all.txt /data/open-c3-data/device/curr/cache/c3mc-device-cat-all.txt" )
    if result is None:
        exit(1)

    for line in result:
        processed = process_result(line)
        if processed:
            print(processed)

if __name__ == '__main__':
    if len(sys.argv) < 2:
        print(f"Usage: {sys.argv[0]} <search_text>", file=sys.stderr)
        exit(1)

    main(sys.argv[1])
