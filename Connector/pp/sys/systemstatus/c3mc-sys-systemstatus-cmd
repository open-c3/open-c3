#!/bin/bash
# Safer script for executing a command and storing status in OpenC3.

export PATH="$PATH:/usr/sbin"

# ---------------------------------------------------------------------------
# 参数检查
# ---------------------------------------------------------------------------
if [ $# -lt 6 ]; then
    echo "Usage: $0 <timeout> <system> <module> <group> <name> <cmd> [args...]"
    exit 1
fi

TIMEOUT="$1"
SYSTEM="$2"
MODULE="$3"
GROUP="$4"
NAME="$5"
shift 5   # 剩余的就是命令本体

# ---------------------------------------------------------------------------
# 计算 timeout 参数逻辑
# ---------------------------------------------------------------------------
if [[ "$TIMEOUT" -eq 0 ]]; then
    DB_TIMEOUT=0
else
    NOW_TS=$(date +%s)
    DB_TIMEOUT=$(( NOW_TS + TIMEOUT ))
fi

# ---------------------------------------------------------------------------
# 执行命令，返回退出码
# ---------------------------------------------------------------------------
run_command() {
    "$@"       # 执行命令
    return $?  # 返回退出码
}

run_command "$@"
CODE=$?

# ---------------------------------------------------------------------------
# 状态计算
# ---------------------------------------------------------------------------
if [[ "$CODE" -eq 0 ]]; then
    STATUS="success"
else
    STATUS="code:$CODE"
fi

# ---------------------------------------------------------------------------
# 写入数据库
# ---------------------------------------------------------------------------
c3mc-base-db-ins \
    -t openc3_connector_systemstatus \
    system "$SYSTEM" \
    module "$MODULE" \
    group "$GROUP" \
    name "$NAME" \
    status "$STATUS" \
    timeout "$DB_TIMEOUT"

