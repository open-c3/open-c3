#!/data/Software/mydan/perl/bin/perl
use strict;
use warnings;

$|++;

use AnyEvent;
use AnyEvent::Ping;
 
$|++;

my @node = <STDIN>;
chomp @node;

my %res;
for my $x ( @node )
{
    my ( $host, $stat ) = split /\s+/, $x;
    $res{$host} = $stat ? 1 : $res{$host} ? 1 : 0;
}

map{ printf "$_ %s\n", $res{$_} ? 1 : 0 }keys %res;

exit unless my @host = grep{ ! $res{$_} }keys %res;

## Start

my $times = 3;
my $c = AnyEvent->condvar;
 
my $ping = AnyEvent::Ping->new;

for my $host ( @host  )
{
    $ping->ping($host, $times, sub {
        my $results = shift;
        foreach my $result (@$results) {
            my $status = $result->[0];
            print "$host 1\n" if $status eq 'OK';
        };
        $c->send;
    });
 
}

my $timer = AnyEvent->timer( after => 5, cb => sub { exit; } );

$c->recv;
$ping->end;
